---
import {
  getProvinces,
  getCities,
  getDistricts,
} from "../../../../lib/kode-pos/config";

export const prerender = false;

const { provinsi, kota } = Astro.params;

const provinces = await getProvinces();

const province = provinces.find(
  (item) => item.slug === provinsi
);

if (!province) {
  return new Response(
    `Provinsi tidak ditemukan: ${provinsi}`,
    {
      status: 404,
      headers: {
        "Content-Type": "text/html; charset=utf-8",
      },
    }
  );
}

const cities = await getCities(
  Astro.locals,
  province.prov_id
);

const city = cities.find(
  (item) => item.slug === kota
);

if (!city) {
  return new Response(
    `Kabupaten/Kota tidak ditemukan: ${kota}`,
    {
      status: 404,
      headers: {
        "Content-Type": "text/html; charset=utf-8",
      },
    }
  );
}

const districts = await getDistricts(
  Astro.locals,
  city.city_id
);
---

<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  />

  <title>
    Kode Pos {city.name}, {province.name}
  </title>

  <meta
    name="description"
    content={`Daftar kecamatan dan kode pos ${city.name}, ${province.name}.`}
  />
</head>

<body>
  <main>

    <nav>
      <a href="/kode-pos/">Kode Pos</a>
      /
      <a href={`/kode-pos/${province.slug}/`}>
        {province.name}
      </a>
      /
      <span>{city.name}</span>
    </nav>

    <h1>Kode Pos {city.name}</h1>

    <p>
      Daftar kecamatan dan kode pos di
      {city.name}, {province.name}.
    </p>

    {districts.length > 0 ? (
      <ul>
        {districts.map((district) => (
          <li>
            <a
              href={`/kode-pos/${province.slug}/${city.slug}/${district.slug}/`}
            >
              {district.name}
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p>Data kecamatan tidak tersedia.</p>
    )}

  </main>
</body>
</html>
