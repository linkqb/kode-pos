---
import MainLayout from "../../../../layouts/MainLayout.astro";
import "../../../../styles/kode-pos.css";
import { API_BASE_URL } from "../../../../lib/kode-pos/config";
const provinsi=Astro.params.provinsi||"", kota=Astro.params.kota||"";
---
<MainLayout title="Kode Pos Kota" description="Daftar kecamatan untuk wilayah kota.">
<main class="kode-pos-page"><div class="kode-pos-container">
<nav class="kode-pos-breadcrumb"><a href="/">Kode Pos</a><span>/</span><a href={`/kode-pos/${provinsi}/`}>{provinsi}</a><span>/</span><span id="city-name">Memuat...</span></nav>
<header class="kodepos-header"><h1>Kode Pos <span id="heading-name">Kota</span></h1><p class="kodepos-lead">Pilih kecamatan.</p></header>
<div id="status" class="kodepos-lead">Memuat...</div><section id="grid" class="kodepos-grid"></section>
</div></main>
</MainLayout>
<script define:vars={{ API_BASE_URL, provinsi, kota }}>
const norm=v=>v.toLowerCase().trim().replace(/[()]/g,"").replace(/[^a-z0-9]+/g,"-").replace(/^-+|-+$/g,"");
const grid=document.querySelector("#grid"),status=document.querySelector("#status");
try {
 const pr=await fetch(`${API_BASE_URL}/api/kode-pos/provinsi`); const pj=await pr.json();
 const p=(pj.data||[]).find(x=>norm(x.name)===provinsi); if(!p) throw 0;
 const cr=await fetch(`${API_BASE_URL}/api/kode-pos/kota?prov_id=${encodeURIComponent(p.id)}`); const cj=await cr.json();
 const c=(cj.data||[]).find(x=>norm(x.name)===kota); if(!c) throw 0;
 document.querySelector("#city-name").textContent=c.name; document.querySelector("#heading-name").textContent=c.name;
 const dr=await fetch(`${API_BASE_URL}/api/kode-pos/kecamatan?city_id=${encodeURIComponent(c.id)}`); const dj=await dr.json();
 const data=dj.data||[]; status.textContent=`${data.length} kecamatan`;
 grid.innerHTML=data.map(d=>`<a class="kodepos-card" href="/kode-pos/${norm(p.name)}/${norm(c.name)}/${norm(d.name)}/"><div class="kodepos-card-content"><h2>${d.name}</h2><p>Lihat kelurahan, desa, dan kode pos</p></div><span class="kodepos-card-arrow">→</span></a>`).join("");
} catch { status.textContent="Kota tidak ditemukan atau data tidak dapat dimuat."; }
</script>
