---
import MainLayout from "../../layouts/MainLayout.astro";
import "../../styles/kode-pos.css";
import { getProvinces, kodePosUrl } from "../../lib/kode-pos/config";
const provinces = await getProvinces();
---
<MainLayout title="Provinsi - Kode Pos" description="Daftar provinsi Indonesia.">
<main class="kode-pos-page"><div class="kode-pos-container">
<nav class="kode-pos-breadcrumb"><a href="/">Kode Pos</a><span>/</span><span>Provinsi</span></nav>
<header class="kodepos-header"><h1>Provinsi</h1><p class="kodepos-lead">Pilih provinsi.</p></header>
<section class="kodepos-grid">{provinces.map(p=><a class="kodepos-card" href={kodePosUrl(p.name)}><div class="kodepos-card-content"><h2>{p.name}</h2></div><span class="kodepos-card-arrow">→</span></a>)}</section>
</div></main>
</MainLayout>
