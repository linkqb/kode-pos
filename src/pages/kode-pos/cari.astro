---
const q = Astro.url.searchParams.get("q")?.trim() || "";
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>
      {q ? `Cari Kode Pos ${q}` : "Cari Kode Pos"}
    </title>

    <meta
      name="description"
      content="Cari kode pos Indonesia berdasarkan nama wilayah atau kode pos."
    />

    <link
      rel="canonical"
      href="https://kodepos.linkqb.com/kode-pos/cari/"
    />
  </head>

  <body>
    <main>
      <nav>
        <a href="/kode-pos/">Kode Pos</a>
        /
        <span>Pencarian</span>
      </nav>

      <h1>Cari Kode Pos</h1>

      <p>
        Cari provinsi, kabupaten/kota, kecamatan,
        kelurahan/desa, atau kode pos.
      </p>

      <form method="get" action="/kode-pos/cari/">
        <input
          type="search"
          name="q"
          value={q}
          placeholder="Cari kode pos..."
          autocomplete="off"
        />

        <button type="submit">
          Cari
        </button>
      </form>

      {q && (
        <section>
          <h2>Hasil pencarian</h2>
          <p>
            Kata pencarian:
            <strong>{q}</strong>
          </p>

          <p>
            Belum ada hasil pencarian.
          </p>
        </section>
      )}
    </main>
  </body>
</html>
