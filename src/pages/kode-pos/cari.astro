---
const API_BASE =
  "https://api-kodepos.linkq.workers.dev/api/kode-pos";

const q = (Astro.url.searchParams.get("q") || "").trim();

let results = [];
let error = "";

if (q.length >= 2) {
  try {
    const res = await fetch(
      `${API_BASE}/search?q=${encodeURIComponent(q)}`
    );

    if (!res.ok) {
      throw new Error(`API HTTP ${res.status}`);
    }

    const json = await res.json();

    results = json.data || [];
  } catch (e) {
    console.error("SEARCH ERROR:", e);
    error = "Gagal mengambil data pencarian.";
  }
}
---

<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  />

  <title>
    {q ? `Cari Kode Pos: ${q}` : "Cari Kode Pos"}
  </title>

  <meta
    name="description"
    content="Cari kode pos berdasarkan provinsi, kabupaten atau kota, kecamatan, kelurahan atau desa."
  />
</head>

<body>

  <main>

    <nav>
      <a href="/kode-pos/">Kode Pos</a>
      /
      <span>Pencarian</span>
    </nav>

    <h1>Cari Kode Pos</h1>

    <p>
      Cari provinsi, kabupaten/kota, kecamatan,
      kelurahan/desa, atau kode pos.
    </p>

    <form
      method="get"
      action="/kode-pos/cari/"
    >
      <input
        type="search"
        name="q"
        value={q}
        placeholder="Cari kode pos..."
        autocomplete="off"
        minlength="2"
        required
      />

      <button type="submit">
        Cari
      </button>
    </form>

    {
      q && (
        <section>

          <h2>
            Hasil pencarian
          </h2>

          <p>
            Kata pencarian:
            <strong>{q}</strong>
          </p>

          {
            error ? (
              <p>{error}</p>
            ) : results.length > 0 ? (
              <div>

                {results.map((item) => (
                  <article>

                    <h3>
                      {item.subdis_name}
                    </h3>

                    <p>
                      <strong>
                        {item.postal_code}
                      </strong>
                    </p>

                    <p>
                      {item.dis_name},{" "}
                      {item.city_name},{" "}
                      {item.prov_name}
                    </p>

                  </article>
                ))}

              </div>
            ) : (
              <p>
                Tidak ditemukan hasil untuk "{q}".
              </p>
            )
          }

        </section>
      )
    }

    {
      !q && (
        <p>
          Masukkan nama wilayah atau kode pos untuk mencari.
        </p>
      )
    }

  </main>

</body>
</html>
