---
import MainLayout from '../layouts/MainLayout.astro';
import '../styles/kode-pos.css';
import { getProvinces, kodePosUrl } from '../lib/kode-pos/config';

let provinces = [];
let apiError = false;
try {
  provinces = await getProvinces();
} catch {
  apiError = true;
}
---
<MainLayout title="Kode Pos Indonesia" description="Cari kode pos Indonesia.">
  <main class="kode-pos-page"><div class="kode-pos-container">
    <header class="kodepos-header">
      <span class="kodepos-eyebrow">Kode Pos Indonesia</span>
      <h1>Cari Kode Pos Indonesia</h1>
      <p class="kodepos-lead">Pilih provinsi untuk melihat wilayah kode pos.</p>
    </header>
    {apiError ? (
      <section class="kodepos-header">
        <h2>Data Kode Pos sedang tidak tersedia</h2>
        <p class="kodepos-lead">Server berhasil berjalan, tetapi API Kode Pos belum merespons.</p>
        <a href="/api/health">Cek status halaman</a>
      </section>
    ) : (
      <section class="kodepos-grid">
        {provinces.map((p) => (
          <a class="kodepos-card" href={kodePosUrl(p.name)}>
            <div class="kodepos-card-content"><h2>{p.name}</h2><p>Lihat kabupaten dan kota</p></div>
            <span class="kodepos-card-arrow">→</span>
          </a>
        ))}
      </section>
    )}
  </div></main>
</MainLayout>
