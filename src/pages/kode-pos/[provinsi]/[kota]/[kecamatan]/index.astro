---
import {
  getProvinces,
  getCities,
  getDistricts,
  getPostalCodes,
} from "../../../../../lib/kode-pos/config";

export const prerender = false;

const { provinsi, kota, kecamatan } = Astro.params;

const provinces = await getProvinces();

const province = provinces.find(
  (item) => item.slug === provinsi
);

if (!province) {
  return new Response("Provinsi tidak ditemukan", {
    status: 404,
  });
}

const cities = await getCities(
  Astro.locals,
  province.prov_id
);

const city = cities.find(
  (item) => item.slug === kota
);

if (!city) {
  return new Response("Kabupaten / kota tidak ditemukan", {
    status: 404,
  });
}

const districts = await getDistricts(
  Astro.locals,
  city.city_id
);

const district = districts.find(
  (item) => item.slug === kecamatan
);

if (!district) {
  return new Response("Kecamatan tidak ditemukan", {
    status: 404,
  });
}

const postalCodes = await getPostalCodes(
  Astro.locals,
  district.dis_id
);
---

<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  />

  <title>
    Kode Pos {district.name}, {city.name}, {province.name}
  </title>

  <meta
    name="description"
    content={`Daftar kode pos ${district.name}, ${city.name}, ${province.name}.`}
  />
</head>

<body>
  <main>

    <nav>
      <a href="/kode-pos/">Kode Pos</a>
      /
      <a href={`/kode-pos/${province.slug}/`}>
        {province.name}
      </a>
      /
      <a href={`/kode-pos/${province.slug}/${city.slug}/`}>
        {city.name}
      </a>
      /
      <span>{district.name}</span>
    </nav>

    <h1>Kode Pos {district.name}</h1>

    <p>
      Daftar kode pos {district.name},
      {city.name},
      {province.name}.
    </p>

    {
      postalCodes.length > 0 ? (
        <table>
          <thead>
            <tr>
              <th>Kelurahan / Desa</th>
              <th>Kode Pos</th>
            </tr>
          </thead>

          <tbody>
            {postalCodes.map((item) => (
              <tr>
                <td>{item.subdis_name}</td>
                <td>{item.postal_code}</td>
              </tr>
            ))}
          </tbody>
        </table>
      ) : (
        <p>Data kode pos tidak tersedia.</p>
      )
    }

  </main>
</body>
</html>
