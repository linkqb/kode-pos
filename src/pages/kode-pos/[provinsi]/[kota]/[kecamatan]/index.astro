---
import MainLayout from "../../../../../layouts/MainLayout.astro";
import "../../../../../styles/kode-pos.css";
import { getProvinces,getCities,getDistricts,getSubdistricts,kodePosUrl,slugify } from "../../../../../lib/kode-pos/config";
const provinsi=Astro.params.provinsi||"", kota=Astro.params.kota||"", kecamatan=Astro.params.kecamatan||"";
const provinces=await getProvinces();
const province=provinces.find(p=>slugify(p.name)===provinsi);
const cities=province?await getCities(province.id):[];
const city=cities.find(c=>slugify(c.name)===kota);
const districts=city?await getDistricts(city.id):[];
const district=districts.find(d=>slugify(d.name)===kecamatan);
if(!province||!city||!district) Astro.response.status=404;
const subdistricts=district?await getSubdistricts(district.id):[];
---
<MainLayout title={district?`Kode Pos ${district.name}, ${city?.name}, ${province?.name}`:"Kecamatan Tidak Ditemukan"} description={district?`Kelurahan dan desa beserta kode pos di ${district.name}.`:"Kecamatan tidak ditemukan."}>
<main class="kode-pos-page"><div class="kode-pos-container">
{province&&city&&district?<><nav class="kode-pos-breadcrumb"><a href="/">Kode Pos</a><span>/</span><a href={kodePosUrl(province.name)}>{province.name}</a><span>/</span><a href={kodePosUrl(province.name,city.name)}>{city.name}</a><span>/</span><span>{district.name}</span></nav><header class="kodepos-header"><h1>Kode Pos {district.name}</h1><p class="kodepos-lead">Kelurahan dan desa di {district.name}, {city.name}, {province.name}.</p></header><section class="kodepos-grid">{subdistricts.map(s=><article class="kodepos-card"><div class="kodepos-card-content"><h2>{s.name}</h2><p>{district.name}, {city.name}</p></div><strong class="kodepos-card-arrow">{s.postal_code}</strong></article>)}</section></>:<section class="kodepos-header"><h1>Kecamatan tidak ditemukan</h1><a href="/kode-pos/">Kembali</a></section>}
</div></main>
</MainLayout>
