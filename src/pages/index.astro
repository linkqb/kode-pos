---
import MainLayout from '../layouts/MainLayout.astro';
import '../styles/kode-pos.css';
---
<MainLayout
  title="Kode Pos Indonesia"
  description="Cari kode pos berdasarkan provinsi, kota, kecamatan, dan kelurahan."
>
  <main class="kode-pos-page">
    <div class="kode-pos-container">
      <header class="kodepos-header">
        <span class="kodepos-eyebrow">Kode Pos Indonesia</span>
        <h1>Cari Kode Pos</h1>
        <p class="kodepos-lead">Pilih wilayah untuk menemukan kode pos.</p>
      </header>
      <section class="search-box">
        <a class="kodepos-card" href="/kode-pos/">
          <div>
            <h2>Buka pencarian Kode Pos</h2>
            <p>Pilih provinsi, kota, dan kecamatan.</p>
          </div>
          <span class="kodepos-card-arrow">→</span>
        </a>
      </section>
    </div>
  </main>
</MainLayout>
