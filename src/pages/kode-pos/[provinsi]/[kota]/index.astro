---
export const prerender = false;
import MainLayout from '../../../../layouts/MainLayout.astro';
import '../../../../styles/kode-pos.css';
const province = Astro.params.provinsi || '';
const city = Astro.params.kota || '';
---
<MainLayout title={`Kode Pos ${city}, ${province}`} description={`Kode pos ${city}, ${province}.`}>
  <main class="kode-pos-page"><div class="kode-pos-container">
    <h1>Kode Pos {city}</h1>
    <p>{province}</p>
  </div></main>
</MainLayout>
