---
import MainLayout from '../../layouts/MainLayout.astro';
import '../../styles/kode-pos.css';
import { getProvinces, kodePosUrl, slugify } from '../../lib/kode-pos/config';

const provinces = await getProvinces();
---
<MainLayout title="Kode Pos Indonesia" description="Pilih provinsi untuk mencari kode pos.">
  <main class="kode-pos-page">
    <div class="kode-pos-container">
      <header class="kodepos-header">
        <span class="kodepos-eyebrow">Kode Pos Indonesia</span>
        <h1>Pilih Provinsi</h1>
        <p class="kodepos-lead">Data wilayah diambil dari API saat halaman diperlukan.</p>
      </header>
      <section class="kodepos-grid">
        {provinces.map((province) => (
          <a class="kodepos-card" href={kodePosUrl(slugify(province.name))}>
            <div class="kodepos-card-content">
              <h2>{province.name}</h2>
            </div>
            <span class="kodepos-card-arrow">→</span>
          </a>
        ))}
      </section>
    </div>
  </main>
</MainLayout>
