---
import MainLayout from '../../../../layouts/MainLayout.astro';
import '../../../../styles/kode-pos.css';
import { getProvinces, getCities, getDistricts, kodePosUrl, slugify } from '../../../../lib/kode-pos/config';

const provinceSlug = Astro.params.provinsi ?? '';
const citySlug = Astro.params.kota ?? '';

const provinces = await getProvinces();
const province = provinces.find((p) => slugify(p.name) === provinceSlug);
const cities = province ? await getCities(province.id) : [];
const city = cities.find((c) => slugify(c.name) === citySlug);

if (!province || !city) Astro.response.status = 404;

const districts = city ? await getDistricts(city.id) : [];
---
<MainLayout
  title={city ? `Kode Pos ${city.name}, ${province!.name}` : 'Kota Tidak Ditemukan'}
  description={city ? `Daftar kecamatan di ${city.name}, ${province!.name}.` : 'Kota tidak ditemukan.'}
>
  <main class="kode-pos-page">
    <div class="kode-pos-container">
      {province && city ? (
        <>
          <nav class="kode-pos-breadcrumb">
            <a href="/kode-pos/">Kode Pos</a><span>/</span>
            <a href={kodePosUrl(slugify(province.name))}>{province.name}</a><span>/</span>
            <span>{city.name}</span>
          </nav>
          <header class="kodepos-header">
            <span class="kodepos-eyebrow">Kode Pos Indonesia</span>
            <h1>Kode Pos {city.name}</h1>
            <p class="kodepos-lead">Pilih kecamatan.</p>
          </header>
          <section class="kodepos-grid">
            {districts.map((district) => (
              <a class="kodepos-card" href={kodePosUrl(slugify(province.name), slugify(city.name), slugify(district.name))}>
                <div><h2>{district.name}</h2><p>Lihat kelurahan dan kode pos</p></div>
                <span class="kodepos-card-arrow">→</span>
              </a>
            ))}
          </section>
        </>
      ) : (
        <section class="kodepos-header"><h1>Kota tidak ditemukan</h1><a href="/kode-pos/">Kembali</a></section>
      )}
    </div>
  </main>
</MainLayout>
