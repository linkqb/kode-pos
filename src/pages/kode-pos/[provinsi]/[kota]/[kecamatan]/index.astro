---
import MainLayout from "../../../../../layouts/MainLayout.astro";
import "../../../../../styles/kode-pos.css";
import { API_BASE_URL } from "../../../../../lib/kode-pos/config";
const provinsi=Astro.params.provinsi||"", kota=Astro.params.kota||"", kecamatan=Astro.params.kecamatan||"";
---
<MainLayout title="Kode Pos Kecamatan" description="Daftar kelurahan dan desa beserta kode pos.">
<main class="kode-pos-page"><div class="kode-pos-container">
<nav class="kode-pos-breadcrumb"><a href="/">Kode Pos</a><span>/</span><a href={`/kode-pos/${provinsi}/`}>{provinsi}</a><span>/</span><a href={`/kode-pos/${provinsi}/${kota}/`}>{kota}</a><span>/</span><span id="district-name">Memuat...</span></nav>
<header class="kodepos-header"><h1>Kode Pos <span id="heading-name">Kecamatan</span></h1><p id="lead" class="kodepos-lead">Memuat data kelurahan dan desa...</p></header>
<div id="status" class="kodepos-lead"></div><section id="grid" class="kodepos-grid"></section>
</div></main>
</MainLayout>
<script define:vars={{ API_BASE_URL, provinsi, kota, kecamatan }}>
const norm=v=>v.toLowerCase().trim().replace(/[()]/g,"").replace(/[^a-z0-9]+/g,"-").replace(/^-+|-+$/g,"");
const grid=document.querySelector("#grid"),status=document.querySelector("#status");
try {
 const pr=await fetch(`${API_BASE_URL}/api/kode-pos/provinsi`); const pj=await pr.json();
 const p=(pj.data||[]).find(x=>norm(x.name)===provinsi); if(!p) throw 0;
 const cr=await fetch(`${API_BASE_URL}/api/kode-pos/kota?prov_id=${encodeURIComponent(p.id)}`); const cj=await cr.json();
 const c=(cj.data||[]).find(x=>norm(x.name)===kota); if(!c) throw 0;
 const dr=await fetch(`${API_BASE_URL}/api/kode-pos/kecamatan?city_id=${encodeURIComponent(c.id)}`); const dj=await dr.json();
 const d=(dj.data||[]).find(x=>norm(x.name)===kecamatan); if(!d) throw 0;
 document.querySelector("#district-name").textContent=d.name; document.querySelector("#heading-name").textContent=d.name;
 document.querySelector("#lead").textContent=`Kelurahan dan desa di ${d.name}, ${c.name}, ${p.name}.`;
 const sr=await fetch(`${API_BASE_URL}/api/kode-pos/kelurahan?dis_id=${encodeURIComponent(d.id)}`); const sj=await sr.json();
 const data=sj.data||[]; status.textContent=`${data.length} data`;
 grid.innerHTML=data.map(s=>`<article class="kodepos-card"><div class="kodepos-card-content"><h2>${s.name}</h2><p>${d.name}, ${c.name}</p></div><strong class="kodepos-card-arrow">${s.postal_code||"—"}</strong></article>`).join("");
} catch { status.textContent="Kecamatan tidak ditemukan atau data tidak dapat dimuat."; }
</script>
