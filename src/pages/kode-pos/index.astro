---
import MainLayout from "../../layouts/MainLayout.astro";
import "../../styles/kode-pos.css";
import { API_BASE_URL } from "../../lib/kode-pos/config";
---
<MainLayout title="Provinsi - Kode Pos" description="Daftar provinsi untuk pencarian kode pos.">
  <main class="kode-pos-page">
    <div class="kode-pos-container">
      <nav class="kode-pos-breadcrumb"><a href="/">Kode Pos</a><span>/</span><span>Provinsi</span></nav>
      <header class="kodepos-header">
        <h1>Provinsi</h1>
        <p class="kodepos-lead">Pilih provinsi untuk melihat kabupaten dan kota.</p>
      </header>
      <div id="status" class="kodepos-lead">Memuat...</div>
      <section id="grid" class="kodepos-grid"></section>
    </div>
  </main>
</MainLayout>

<script define:vars={{ API_BASE_URL }}>
  const grid = document.querySelector("#grid");
  const status = document.querySelector("#status");
  const slugify = v => v.toLowerCase().trim().replace(/[()]/g,"").replace(/[^a-z0-9]+/g,"-").replace(/^-+|-+$/g,"");
  try {
    const r = await fetch(`${API_BASE_URL}/api/kode-pos/provinsi`);
    const j = await r.json();
    const data = Array.isArray(j.data) ? j.data : [];
    status.textContent = `${data.length} provinsi`;
    grid.innerHTML = data.map(p => `<a class="kodepos-card" href="/kode-pos/${slugify(p.name)}/"><div class="kodepos-card-content"><h2>${p.name}</h2><p>Lihat kabupaten dan kota</p></div><span class="kodepos-card-arrow">→</span></a>`).join("");
  } catch { status.textContent = "Data tidak dapat dimuat."; }
</script>
