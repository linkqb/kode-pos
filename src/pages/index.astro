---
import MainLayout from "../layouts/MainLayout.astro";
import "../styles/kode-pos.css";
import { API_BASE_URL } from "../lib/kode-pos/config";
---

<MainLayout
  title="Kode Pos Indonesia"
  description="Cari kode pos Indonesia berdasarkan provinsi, kota, kecamatan, dan kelurahan."
>
  <main class="kode-pos-page">
    <div class="kode-pos-container">
      <header class="kodepos-header">
        <span class="kodepos-eyebrow">Kode Pos Indonesia</span>
        <h1>Cari Kode Pos</h1>
        <p class="kodepos-lead">Pilih provinsi untuk memulai pencarian.</p>
      </header>

      <section>
        <div id="province-status" class="kodepos-lead">Memuat provinsi...</div>
        <div id="province-grid" class="kodepos-grid"></div>
      </section>
    </div>
  </main>
</MainLayout>

<script define:vars={{ API_BASE_URL }}>
  const grid = document.querySelector("#province-grid");
  const status = document.querySelector("#province-status");

  function slugify(value) {
    return value.toLowerCase().trim()
      .replace(/[()]/g, "")
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "");
  }

  async function loadProvinces() {
    try {
      const response = await fetch(`${API_BASE_URL}/api/kode-pos/provinsi`);
      if (!response.ok) throw new Error("API error");
      const result = await response.json();
      const data = Array.isArray(result.data) ? result.data : [];

      status.textContent = data.length ? `${data.length} provinsi` : "Data provinsi tidak ditemukan.";

      grid.innerHTML = data.map((item) => `
        <a class="kodepos-card" href="/kode-pos/${slugify(item.name)}/">
          <div class="kodepos-card-content">
            <h2>${item.name}</h2>
            <p>Lihat kabupaten dan kota</p>
          </div>
          <span class="kodepos-card-arrow">→</span>
        </a>
      `).join("");
    } catch {
      status.textContent = "Data belum dapat dimuat. Silakan coba lagi.";
    }
  }

  loadProvinces();
</script>
