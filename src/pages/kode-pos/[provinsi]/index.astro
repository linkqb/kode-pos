---
import { getProvinces, getCities } from "../../../lib/kode-pos/config";

export const prerender = false;

const { provinsi } = Astro.params;

if (!provinsi) {
  return Astro.redirect("/kode-pos/");
}

const provinces = await getProvinces();

const province = provinces.find(
  (item) => item.slug === provinsi
);

if (!province) {
  return new Response("Provinsi tidak ditemukan", {
    status: 404,
    headers: {
      "Content-Type": "text/html; charset=utf-8",
    },
  });
}

const cities = await getCities(Astro.locals, province.prov_id);
---

<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Kode Pos {province.name}</title>
  <meta
    name="description"
    content={`Daftar kode pos dan kabupaten kota di ${province.name}.`}
  />
</head>

<body>
  <main>
    <nav>
      <a href="/kode-pos/">Kode Pos</a>
      /
      <span>{province.name}</span>
    </nav>

    <h1>Kode Pos {province.name}</h1>

    {cities.length > 0 ? (
      <ul>
        {cities.map((city) => (
          <li>
            <a
              href={`/kode-pos/${province.slug}/${city.slug}/`}
            >
              {city.name}
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p>Data kabupaten/kota tidak tersedia.</p>
    )}
  </main>
</body>
</html>
