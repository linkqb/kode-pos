---
import MainLayout from "../../../layouts/MainLayout.astro";
import "../../../styles/kode-pos.css";
import { getProvinces,getCities,kodePosUrl,slugify } from "../../../lib/kode-pos/config";
const slug=Astro.params.provinsi||"";
const provinces=await getProvinces();
const province=provinces.find(p=>slugify(p.name)===slug);
if(!province) Astro.response.status=404;
const cities=province?await getCities(province.id):[];
---
<MainLayout title={province?`Kode Pos ${province.name}`:"Provinsi Tidak Ditemukan"} description={province?`Daftar kabupaten dan kota di ${province.name}.`:"Provinsi tidak ditemukan."}>
<main class="kode-pos-page"><div class="kode-pos-container">
{province?<><nav class="kode-pos-breadcrumb"><a href="/">Kode Pos</a><span>/</span><span>{province.name}</span></nav><header class="kodepos-header"><h1>Kode Pos {province.name}</h1><p class="kodepos-lead">Pilih kabupaten atau kota.</p></header><section class="kodepos-grid">{cities.map(c=><a class="kodepos-card" href={kodePosUrl(province.name,c.name)}><div class="kodepos-card-content"><h2>{c.name}</h2><p>Lihat kecamatan</p></div><span class="kodepos-card-arrow">→</span></a>)}</section></>:<section class="kodepos-header"><h1>Provinsi tidak ditemukan</h1><a href="/kode-pos/">Kembali</a></section>}
</div></main>
</MainLayout>
