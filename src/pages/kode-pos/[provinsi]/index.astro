---
import MainLayout from "../../../layouts/MainLayout.astro";
import "../../../styles/kode-pos.css";

import {
  resolveProvince,
  getCities,
  kodePosUrl,
} from "../../../lib/kode-pos/config";

const province = await resolveProvince(
  Astro.locals,
  Astro.params.provinsi || ""
);

if (!province) {
  Astro.response.status = 404;
}

const cities = province
  ? await getCities(Astro.locals, province.prov_id)
  : [];

const title = province
  ? `Kode Pos ${province.name}`
  : "Provinsi Tidak Ditemukan";

const description = province
  ? `Daftar kabupaten dan kota beserta informasi kode pos di ${province.name}.`
  : "Provinsi kode pos tidak ditemukan.";
---

<MainLayout title={title} description={description}>
  <main class="kode-pos-page">
    <div class="kode-pos-container">

      {!province ? (
        <section class="kodepos-header">
          <h1>Provinsi tidak ditemukan</h1>

          <p class="kodepos-lead">
            Alamat kode pos yang diminta tidak tersedia.
          </p>

          <a href="/kode-pos/">
            Kembali ke Kode Pos
          </a>
        </section>
      ) : (
        <>
          <nav
            class="kode-pos-breadcrumb"
            aria-label="Breadcrumb"
          >
            <a href="/kode-pos/">Kode Pos</a>
            <span>/</span>
            <span>{province.name}</span>
          </nav>

          <header class="kodepos-header">
            <span class="kodepos-eyebrow">
              Kode Pos Indonesia
            </span>

            <h1>Kode Pos {province.name}</h1>

            <p class="kodepos-lead">
              Pilih kabupaten atau kota di {province.name}.
            </p>
          </header>

          <section class="kodepos-grid">
            {cities.map((city) => (
              <a
                class="kodepos-card"
                href={kodePosUrl(
                  province.slug,
                  city.slug
                )}
              >
                <div class="kodepos-card-content">
                  <h2>{city.name}</h2>

                  <p>
                    Lihat kecamatan dan kode pos
                  </p>
                </div>

                <span class="kodepos-card-arrow">
                  →
                </span>
              </a>
            ))}
          </section>
        </>
      )}

    </div>
  </main>
</MainLayout>
