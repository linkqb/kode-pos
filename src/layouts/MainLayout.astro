---
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Kode Pos Indonesia',
  description = 'Cari kode pos Indonesia.'
} = Astro.props;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <header class="site-header">
      <a href="/">Kode Pos</a>
      <nav>
        <a href="/kode-pos/">Kode Pos</a>
        <a href="/blog/">Blog</a>
      </nav>
    </header>
    <slot />
  </body>
</html>
